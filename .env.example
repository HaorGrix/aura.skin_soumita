# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — never commit real keys.
#
# The backend is self-hosted Supabase on hg-server-01, served on the site's own
# origin (see deploy/SELF-HOSTING.md). Values come from /opt/supabase/.env:
#   VITE_SUPABASE_URL       = https://www.skintheorybd.shop
#   VITE_SUPABASE_ANON_KEY  = ANON_KEY
#
# Vite requires the VITE_ prefix to expose a var to browser code, and inlines
# these at BUILD time — there is no runtime env on a static host, so changing
# them means rebuilding + redeploying.
#
# Only the ANON key belongs here, ever. Never the "service_role" key — that
# one bypasses Row-Level Security and must never reach the browser.

VITE_SUPABASE_URL=https://www.skintheorybd.shop
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Where password-reset and invite-acceptance links should point, no matter
# where they were triggered from. Without this, "Forgot password?" clicked
# on a local dev server would email out a link back to localhost — this is
# what actually broke it before. Set to your real production URL in every
# production build;
# safe to leave unset only for pure local-only testing, where it falls back
# to whatever origin the app is running on.
VITE_SITE_URL=https://www.skintheorybd.shop

# ---------------------------------------------------------------------------
# SERVICE ROLE — for local one-shot Node SCRIPTS ONLY (scripts/*.mjs), never
# for app code. Deliberately NOT prefixed with VITE_ so Vite can never inline
# it into the browser bundle. This key bypasses Row-Level Security entirely —
# treat it like a database root password. Never commit it, never log it,
# never put it in any frontend file.
# Self-hosted: SERVICE_ROLE_KEY in /opt/supabase/.env on the server.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
